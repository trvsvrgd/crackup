    "assets:preview": "node scripts/verify-stage3d-browser.mjs",
    "verify:stage3c:browser": "node scripts/verify-stage3c-browser.mjs",
    "verify:stage3b:browser": "node scripts/verify-stage3b-browser.mjs",
    "verify:stage3a:browser": "node scripts/verify-stage3a-browser.mjs",
    "verify:art:browser": "node scripts/verify-art-browser.mjs",
    "verify": "npm run verify:phase1 && npm run verify:phase2 && npm run verify:phase3 && npm run verify:phase4 && npm run verify:phase5 && npm run verify:phase6 && npm run verify:alpha && npm run verify:stage1 && npm run verify:stage2 && npm run verify:stage3a && npm run verify:stage3b && npm run verify:stage3c && npm run verify:stage3d && npm run verify:stage4 && npm run verify:stage5 && npm run verify:stage6 && npm run verify:quality && npm run verify:controller",
    "dev": "tsx watch server/index.ts",
    "verify:phase1": "tsx tests/verify-phase1.ts",
    "verify:phase2": "tsx tests/verify-phase2.ts",
    "verify:phase3": "tsx tests/verify-phase3.ts",
    "verify:phase4": "tsx tests/verify-phase4.ts",
    "verify:phase5": "tsx tests/verify-phase5.ts",
    "verify:phase6": "tsx tests/verify-phase6.ts",
    "host:online": "npm run build && node scripts/host_online.js",
    "progress": "node scripts/build-progress-artifact.mjs",
    "progress:check": "node scripts/build-progress-artifact.mjs --check",
    "verify:stage4": "tsx tests/verify-stage4.ts",
    "verify:stage4:browser": "node scripts/verify-stage4-browser.mjs",
    "vista:preview": "node scripts/verify-stage4-browser.mjs",
    "verify:stage5": "tsx tests/verify-stage5.ts && tsx tests/verify-stage5-network.ts",
    "verify:stage5:browser": "node scripts/verify-stage5-browser.mjs",
    "effects:preview": "node scripts/verify-stage5-browser.mjs",
    "verify:stage6": "tsx tests/verify-stage6.ts && tsx tests/verify-stage6-network.ts",
    "verify:stage6:browser": "node scripts/verify-stage6-browser.mjs",
    "cinematics:preview": "node scripts/verify-stage6-browser.mjs",
    "verify:lore": "tsx tests/verify-tier1-lore.ts",
    "verify:tier2": "tsx tests/verify-tier2-world.ts",
    "verify:tier3": "tsx tests/verify-tier3-progression.ts",
    "verify:tier4": "tsx tests/verify-tier4-combat-missions.ts"
