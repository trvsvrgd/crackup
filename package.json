{
  "name": "crackup-protocol-eclipse",
  "version": "2.0.0",
  "description": "CRACKUP: Protocol Eclipse — browser-based 3D co-op city sandbox, playable alpha",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "assets:fetch": "node scripts/fetch-prod-assets.mjs",
    "assets:verify": "node scripts/verify-prod-assets.mjs",
    "assets:mixamo": "node scripts/build-mixamo-agent.mjs",
    "build:client": "esbuild client/main.ts --bundle --format=esm --target=es2022 --outfile=public/game.js --sourcemap",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:server && npm run build:client",
    "start": "tsx server/index.ts",
    "start:production": "node dist/server/index.js",
    "verify:alpha": "tsx tests/verify-alpha.ts",
    "verify:stage1": "tsx tests/verify-stage1.ts",
    "verify:stage2": "tsx tests/verify-stage2.ts && tsx tests/verify-stage2-network.ts",
    "verify:stage3a": "tsx tests/verify-stage3a.ts",
    "verify:stage3b": "tsx tests/verify-stage3b.ts && tsx tests/verify-stage3b-network.ts",
    "verify:stage3c": "tsx tests/verify-stage3c.ts && tsx tests/verify-stage3c-network.ts",
    "verify:stage3c:browser": "node scripts/verify-stage3c-browser.mjs",
    "verify:stage3b:browser": "node scripts/verify-stage3b-browser.mjs",
    "verify:stage3a:browser": "node scripts/verify-stage3a-browser.mjs",
    "verify:art:browser": "node scripts/verify-art-browser.mjs",
    "verify": "npm run verify:phase1 && npm run verify:phase2 && npm run verify:phase3 && npm run verify:phase4 && npm run verify:phase5 && npm run verify:phase6 && npm run verify:alpha && npm run verify:stage1 && npm run verify:stage2 && npm run verify:stage3a && npm run verify:stage3b && npm run verify:stage3c",
    "dev": "tsx watch server/index.ts",
    "verify:phase1": "tsx tests/verify-phase1.ts",
    "verify:phase2": "tsx tests/verify-phase2.ts",
    "verify:phase3": "tsx tests/verify-phase3.ts",
    "verify:phase4": "tsx tests/verify-phase4.ts",
    "verify:phase5": "tsx tests/verify-phase5.ts",
    "verify:phase6": "tsx tests/verify-phase6.ts",
    "host:online": "npm run build && node scripts/host_online.js",
    "progress": "node scripts/build-progress-artifact.mjs",
    "progress:check": "node scripts/build-progress-artifact.mjs --check"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "better-sqlite3": "^11.5.0",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "fbx2gltf": "^0.9.7-p1",
    "fflate": "^0.8.3",
    "gltf-validator": "^2.0.0-dev.3.10",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
