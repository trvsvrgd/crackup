    "verify:solo": "tsx tests/verify-solo.ts",
    "product:check": "node scripts/verify-product-requirements.mjs",
    "product:audit:saves": "tsx tests/audit-product-baseline.ts",
    "assets:fetch": "node scripts/fetch-prod-assets.mjs",
    "assets:verify": "node scripts/verify-prod-assets.mjs",
    "assets:mixamo": "node scripts/build-mixamo-agent.mjs",
    "assets:capoeira": "node scripts/build-capoeira-pack.mjs",
    "assets:intake": "node scripts/index-asset-inbox.mjs",
    "build:client": "node scripts/build-client.mjs",
    "verify:quality": "tsx tests/verify-quality.ts",
    "verify:diagnostics": "tsx tests/verify-diagnostics.ts",
    "verify:journal": "tsx tests/verify-diagnostic-journal.ts",
    "verify:reports": "tsx tests/verify-report-export.ts",
    "verify:performance": "tsx tests/verify-performance.ts",
    "verify:map": "tsx tests/verify-map.ts",
    "verify:controller": "tsx tests/verify-controller.ts",
